            <svg class="thumb-art" viewBox="0 0 200 140" width="200" height="140" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
              <path d="M60 40h80v60H60z" />
              <path d="M80 40v-20h40v20" />
              <path d="M70 80h60" />
              <circle cx="100" cy="60" r="15" />
            </svg>
          </div>
          <div class="project-body">
            <div class="project-top">
              <h3>The Artisan Roast</h3>
              <span class="year">2025</span>
